{
  "info": {
    "_postman_id": "hostelhub-nu-aiagai2c-g10",
    "name": "HostelHub - Room Allotment API (NU-AIAGAI2C-G10)",
    "description": "Comprehensive Postman Test Collection for HostelHub BDF Group Assignment.\nTheme 10: Room Allotment.\nCovers Rooms CRUD, Search, Allotments Join, Residents, and the Twist Return Flow Tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Twist Return Flow (The Required Tests)",
      "description": "Specific tests required by the assignment brief for the Return Flow twist.",
      "item": [
        {
          "name": "Test 1: Return a allotment -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"return_date\": \"2026-11-14T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/allotments/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["allotments", "1", "return"]
            },
            "description": "Sets a return date for allotment 1. Must return 200 OK."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Allotment returned successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.allotment).to.have.property(\"return_date\");",
                  "    pm.expect(jsonData.allotment.return_date).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 2: Return it again -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/allotments/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["allotments", "1", "return"]
            },
            "description": "Returning the same allotment a second time. Must return 409 Conflict with message 'Already returned'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Message is 'Already returned'\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Already returned\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 3: GET /residents/1/history -> 200, it is listed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/residents/1/history",
              "host": ["{{baseUrl}}"],
              "path": ["residents", "1", "history"]
            },
            "description": "Lists resident 1's returned allotments history. Must return 200 OK and include allotment 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Resident history is an array and contains returned allotment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    var found = jsonData.some(function(item) { return item.allotment_id === 1; });",
                  "    pm.expect(found).to.be.true;",
                  "});",
                  "pm.test(\"Contains joined room details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData[0]).to.have.property('room_name');",
                  "    pm.expect(jsonData[0]).to.have.property('resident_name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Rooms (CRUD & Search)",
      "description": "Room management routes with status codes, validation, and search query parameters.",
      "item": [
        {
          "name": "Get All Rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is array of rooms\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search Rooms by Block (Query Parameter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms?block=Block A",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"],
              "query": [
                {
                  "key": "block",
                  "value": "Block A"
                }
              ]
            },
            "description": "Search by query parameter: filter rooms by block"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All filtered rooms belong to Block A\", function () {",
                  "    var data = pm.response.json();",
                  "    data.forEach(function(r) {",
                  "        pm.expect(r.block).to.include(\"Block A\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Free Rooms (Warden Helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/free",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "free"]
            },
            "description": "Directly solves client brief: Warden can quickly see free rooms in each block"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Single Room",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns room object with name and block\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('name');",
                  "    pm.expect(data).to.have.property('block');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Room (Success 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Room 501\",\n  \"block\": \"Block E\",\n  \"capacity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Returns created room with ID\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.name).to.eql(\"Room 501\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Room (Validation Failure 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"block\": \"Block E\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            },
            "description": "Validation test: Missing room name returns 400 Bad Request"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Returns validation error message\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('error');",
                  "    pm.expect(data.message).to.include('Room name is required');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Room (200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Room 101 - Deluxe\",\n  \"block\": \"Block A\",\n  \"capacity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Room name updated\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.name).to.eql(\"Room 101 - Deluxe\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Room (200 OK)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/5",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "5"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Allotments (Join Endpoint)",
      "description": "Allotments management and mandatory JOIN endpoint.",
      "item": [
        {
          "name": "One Join Endpoint: Allotments with Resident & Room",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/allotments",
              "host": ["{{baseUrl}}"],
              "path": ["allotments"]
            },
            "description": "MANDATORY JOIN ENDPOINT: Returns allotments joined with resident name and room name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Allotments have joined resident_name and room_name\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    pm.expect(data[0]).to.have.property('resident_name');",
                  "    pm.expect(data[0]).to.have.property('room_name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Allotment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resident_id\": 3,\n  \"room_id\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/allotments",
              "host": ["{{baseUrl}}"],
              "path": ["allotments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
